{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/logout/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/token/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/clause-market/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/debug/lineup/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/league-analysis/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/matches/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/proxy(?:/(.*?))?/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/recommendations/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/score-predictions/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/teams/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/track-record/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/?$",
			"dest": "_render"
		},
		{
			"src": "^/extension/?$",
			"dest": "_render"
		},
		{
			"src": "^/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}