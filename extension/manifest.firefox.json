{
  "manifest_version": 3,
  "name": "Fantasy Manager — Conector LALIGA FANTASY",
  "version": "1.0.0",
  "description": "Inicia sesión en Fantasy Manager con tu cuenta de LALIGA FANTASY (Google incluido) sin copiar tokens a mano.",
  "browser_specific_settings": {
    "gecko": {
      "id": "fantasy-manager@rezzt.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo"],
        "optional": []
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "tabs", "webRequest"],
  "host_permissions": [
    "https://login.laliga.es/*",
    "http://localhost:4321/*",
    "http://127.0.0.1:4321/*",
    "https://fantasy-manager-mauve.vercel.app/*"
  ],
  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:4321/*",
        "http://127.0.0.1:4321/*",
        "https://fantasy-manager-mauve.vercel.app/*"
      ],
      "js": ["src/bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Fantasy Manager"
  }
}
