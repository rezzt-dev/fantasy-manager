#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/rezzt/personal-data/deploy-projects/fantasy-manager/node_modules/.pnpm/find-process@2.1.1/node_modules/find-process/node_modules:/home/rezzt/personal-data/deploy-projects/fantasy-manager/node_modules/.pnpm/find-process@2.1.1/node_modules:/home/rezzt/personal-data/deploy-projects/fantasy-manager/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/rezzt/personal-data/deploy-projects/fantasy-manager/node_modules/.pnpm/find-process@2.1.1/node_modules/find-process/node_modules:/home/rezzt/personal-data/deploy-projects/fantasy-manager/node_modules/.pnpm/find-process@2.1.1/node_modules:/home/rezzt/personal-data/deploy-projects/fantasy-manager/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../dist/cjs/bin/find-process.js" "$@"
else
  exec node  "$basedir/../../dist/cjs/bin/find-process.js" "$@"
fi
