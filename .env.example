# Copia a .env.local para desarrollo. En Vercel se configuran en
# Settings > Environment Variables MARCANDO EL ENTORNO "Build" además de
# "Production"/"Preview": astro.config.mjs decide el driver de sesión en build
# time y lo cuece en el bundle, así que si solo están en Runtime el despliegue
# sale con la sesión en /tmp.

# Almacén compartido de sesión y de cachés (player-stats, calendario, fuentes).
# Sin esto la app arranca y funciona, pero la sesión y los cachés viven en /tmp:
# por instancia y efímeros, así que el usuario pierde la sesión cuando Vercel
# recicla la instancia y cada arranque en frío repite las peticiones a la API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Todo lo de abajo es opcional: hay valores por defecto en el código y solo hace
# falta tocarlo si LALIGA cambia sus endpoints o si se quiere apuntar a otro
# backend en pruebas.
# LALIGA_AUTH_BASE_URL=
# LALIGA_CLIENT_ID=
# LALIGA_REDIRECT_URI=
# PROXY_FANTASY_TARGET=
# PROXY_DEFAULT_X_APP=
# PROXY_DEFAULT_X_LANG=
# PROXY_TIMEOUT_MS=

# Contraste opcional de bajas (servidor únicamente, nunca PUBLIC_).
# API-Football: cuenta propia, cobertura según plan; caché de 24 horas.
API_FOOTBALL_KEY=
