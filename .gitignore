# Dependencies
node_modules/
**/node_modules/
.pnpm-debug.log*
.npm

# Package manager lockfiles (keep pnpm-lock.yaml tracked; ignore others if mixed)
package-lock.json
yarn.lock

# Build outputs
dist/
.astro/
.output/
*.tsbuildinfo

# Salida de build de Vercel. La regenera el adaptador en cada build, así que
# versionarla no aporta nada y además rompe el despliegue: `dist/` y
# `node_modules/` están ignorados y también casan DENTRO de .vercel/output, de
# modo que lo commiteado era una función sin su handler (dist/server/entry.mjs)
# ni sus dependencias -> FUNCTION_INVOCATION_FAILED en todas las rutas.
.vercel/

# Runtime / generated data
data/
!data/.gitkeep

# Cachés regenerables: no van al repo ni al bundle del despliegue. data/cache/
# eran 13 MB de HTML scrapeado que viajaban en cada función serverless; se
# rellenan solos en la primera petición (en serverless, bajo /tmp).
data/cache/

# Cache / session artifacts
.freebuff/
.vite/
.cache/

# Environment and secrets
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production

# Playwright / E2E
test-results/
playwright-report/
playwright/.cache/
e2e/tmp-*/
e2e/screenshot-*.png

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Misc
coverage/
.nyc_output/

# Paquetes de la extensión para las stores
dist-extension/

# Documentación local de agentes (no se versiona)
agent-docs/
